{
  "name": "computer-store", "private": true, "type": "module",
  "workspaces": ["frontend", "api-gateway", "services/*", "packages/*"],
  "scripts": {"lint": "eslint .", "test": "node --test tests/*.test.js", "build": "npm run build --workspace frontend", "smoke": "node scripts/smoke.js", "auth:integration": "docker compose exec -T identity-service node scripts/auth-integration.js", "notification:integration": "docker compose exec -T notification-service node scripts/notification-integration.js", "order:integration": "node scripts/order-integration.js", "phase5:integration": "docker compose --profile test run --rm phase5-integration", "phase6:integration": "docker compose --profile test run --rm phase6-integration"},
  "devDependencies": {"eslint": "^9.39.0", "globals": "^16.5.0", "ajv": "^8.17.1", "ajv-formats": "^3.0.1"}
}
