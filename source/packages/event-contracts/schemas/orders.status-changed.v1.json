{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "order.status-changed"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "enum": [
        "identity-service",
        "catalog-service",
        "order-service",
        "notification-service",
        "analytics-service"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1
        },
        "previousStatus": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "SHIPPING",
            "DELIVERED",
            "CANCELLED"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "CONFIRMED",
            "SHIPPING",
            "DELIVERED",
            "CANCELLED"
          ]
        }
      },
      "required": [
        "orderId",
        "orderNumber",
        "previousStatus",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "key",
    "payload"
  ],
  "additionalProperties": false
}
