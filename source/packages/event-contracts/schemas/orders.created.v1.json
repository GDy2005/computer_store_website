{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "order.created"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "enum": [
        "identity-service",
        "catalog-service",
        "order-service",
        "notification-service",
        "analytics-service"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "customer": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fullName",
            "email",
            "phone"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "variantId": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "productName": {
                "type": "string",
                "minLength": 1
              },
              "categoryName": {
                "type": "string",
                "minLength": 1
              },
              "unitPrice": {
                "type": "integer",
                "minimum": 0
              },
              "unitCost": {
                "type": "integer",
                "minimum": 0
              },
              "lineTotal": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "productId",
              "variantId",
              "quantity",
              "productName",
              "categoryName",
              "unitPrice",
              "unitCost",
              "lineTotal"
            ],
            "additionalProperties": false
          }
        },
        "pricing": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "totalCost": {
              "type": "integer",
              "minimum": 0
            },
            "profit": {
              "type": "integer"
            }
          },
          "required": [
            "total",
            "totalCost",
            "profit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orderId",
        "orderNumber",
        "userId",
        "customer",
        "items",
        "pricing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "key",
    "payload"
  ],
  "additionalProperties": false
}
