{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "foundation.probe"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "enum": [
        "identity-service",
        "catalog-service",
        "order-service",
        "notification-service",
        "analytics-service"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "probeId": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "normal",
            "retry",
            "poison"
          ]
        }
      },
      "required": [
        "probeId",
        "message",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "key",
    "payload"
  ],
  "additionalProperties": false
}
