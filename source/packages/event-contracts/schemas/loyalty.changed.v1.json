{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "loyalty.changed"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "enum": [
        "identity-service",
        "catalog-service",
        "order-service",
        "notification-service",
        "analytics-service"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "transactionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "EARN",
            "REDEEM",
            "REFUND"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "balanceAfter": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "userId",
        "orderId",
        "transactionId",
        "type",
        "points",
        "balanceAfter"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "key",
    "payload"
  ],
  "additionalProperties": false
}
