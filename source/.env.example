HTTP_PORT=80
NODE_ENV=development
INTERNAL_SERVICE_SECRET=local-demo-internal-change-before-production
SESSION_SECRET=local-demo-session-change-before-production
FOUNDATION_PROBES_ENABLED=true
SERVICE_REPLICAS=2

# Keep localhost for the basic setup. Replace it with the public HTTPS tunnel
# URL when enabling public email links, Google OAuth or VNPay callbacks.
FRONTEND_URL=http://localhost

PASSWORD_TOKEN_TTL_MINUTES=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
EMAIL_TRANSPORT=json

ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Replace localhost with a public HTTPS origin before enabling VNPay sandbox.
PAYMENT_PUBLIC_BASE_URL=http://localhost
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PRODUCT_INDEX=products_v1

# Optional. Leave fallback enabled to run without an external AI bill/key.
AI_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_MS=8000
